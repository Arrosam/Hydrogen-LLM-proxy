# Copy to .env next to the compose files, then edit.
# The .env file lives on the VPS only — never commit a filled-in copy.

# --- image ------------------------------------------------------------------
# Pin an immutable tag. `sha-<short>` is built for every push to main; `vX.Y.Z`
# for every release tag. Avoid `latest`.
HYDROGEN_TAG=sha-08e6cea

# --- phase 1: plain HTTP, reachable by IP -----------------------------------
BIND_ADDR=0.0.0.0
HOST_PORT=8080

# --- phase 2: TLS via Caddy (also set BIND_ADDR=127.0.0.1) ------------------
# HYDROGEN_DOMAIN=llm.areel.org
# ACME_EMAIL=samuelin0xcc@gmail.com

# --- app --------------------------------------------------------------------
COOKIE_SECURE=auto
ADMIN_USERNAME=admin
# Leave blank. A temporary password is generated and printed once on first
# boot; read it with `docker compose logs hydrogen`, then change it in the UI.
ADMIN_PASSWORD=
SESSION_TTL=12h
LOG_PAYLOAD_MAX_CHARS=100000
IMAGE_CACHE_MAX_BYTES=67108864
