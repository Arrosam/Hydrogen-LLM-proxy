{
  "version": 5,
  "updated": "2026-08-30",
  "model": "publisher-first",
  "default": "LOW",
  "notes": {
    "model": "The publisher is the source. A domain is only a shortcut for identifying one. Platforms (Baijiahao, WeChat Official Accounts, Zhihu ...) are venues and carry no tier of their own: a national health authority posting on Baijiahao is still that authority, and an anonymous account on the authority own platform would not be.",
    "verification": "On a platform, a publisher may only rise above the platform floor when the result carries a verification signal or the account is listed in that publisher accounts array. Name resemblance is NEVER sufficient.",
    "accounts": "Registry account lists start near-empty on purpose. Populate them from observed search results during Phase 1 rather than guessing; a wrong entry here grants AUTHORITATIVE to an impostor.",
    "region": "Calibrated for mainland simplified-Chinese sources, but search.areel.org currently returns Hong Kong traditional-Chinese results almost exclusively (see docs/05-search-reality-check.md). Hong Kong entries added; full recalibration pending the region decision.",
    "language": "Codebase and documentation are English. displayName, explanation and accounts are product text for a Chinese-speaking user and stay Chinese by design."
  },
  "resolution": [
    "1. Is the domain a platform? → identify the publishing account → verified or in registry? → that publisher's tier, capped at INSTITUTIONAL. Else platform.defaultTier.",
    "2. Does the domain belong to a registry publisher? → that publisher's tier.",
    "3. Does the domain match a publisherPattern? → that pattern's tier.",
    "4. Does the registrable name match a brand named in the query? → scopeRule R3-brand-official.",
    "5. Otherwise → LOW (promotable to INSTITUTIONAL with a stated reason, per spec R2)."
  ],
  "tiers": {
    "AUTHORITATIVE": "联合国及其机构、重大学术院所、PubMed、主要学术期刊",
    "HIGH": "政府部门及其发布、官方媒体、维基百科、厂商说明自家产品参数",
    "MEDIUM": "主流新闻机构、主流自媒体、百度百科、一般机构与数据库",
    "LOW": "个人发帖，以及其余一切"
  },
