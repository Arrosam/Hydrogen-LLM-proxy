# ---------------------------------------------------------------------------
# Hydrogen LLM Proxy - environment configuration
# Copy to `.env` and fill in. Never commit your real `.env`.
# ---------------------------------------------------------------------------

# HTTP port the proxy + dashboard listen on.
PORT=8080

# Directory for the SQLite database file (mounted as a volume in Docker).
DATA_DIR=/data

# ---------------------------------------------------------------------------
# SECURITY (optional - leave blank to auto-generate)
# ---------------------------------------------------------------------------
# If either value below is left blank, Hydrogen generates a strong random one on
# first boot and stores it in DATA_DIR/hydrogen-secrets.json (persisted with your
# data, so it stays stable across restarts). For stronger security you may set
# them explicitly here instead.

# Master key used to encrypt provider API keys at rest (AES-256-GCM).
# Must be 32 bytes, base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CHANGING THIS AFTER FIRST BOOT WILL MAKE STORED PROVIDER KEYS UNREADABLE.
PROXY_MASTER_KEY=

# Secret used to sign dashboard session cookies (any long random string >= 16 chars).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# FIRST-RUN ADMIN (created only if no users exist yet)
# ---------------------------------------------------------------------------
# Leave ADMIN_PASSWORD blank to have a temporary password generated and printed
# in the startup logs; you will be asked to set your own password at first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# How long a dashboard session stays valid.
SESSION_TTL=12h

# Max characters of request/response payload stored per log row.
# 0 = unlimited: full prompts AND responses are persisted verbatim in the DB.
# That can accumulate sensitive user data and grow the database without bound,
# so keep a finite cap unless you specifically need complete payload capture.
LOG_PAYLOAD_MAX_CHARS=2000000

# Session cookie Secure flag: 'auto' sets it only on HTTPS requests (honouring
# X-Forwarded-Proto). Use 'false' behind a plain-HTTP proxy, 'true' to force.
COOKIE_SECURE=auto

# How far to trust X-Forwarded-* headers (Fastify trustProxy semantics).
# 'false' (default): trust nothing -- req.ip is the socket address. Safe when
# the port is exposed directly (the default docker-compose flow); a spoofed
# X-Forwarded-For would otherwise rotate the rate-limit key and defeat the
# login limiter. Behind a reverse proxy you control, set 'true' (trust every
# hop) or a hop count such as '1'.
TRUST_PROXY=false

# Allow provider baseUrl to point at private/loopback/LAN addresses (e.g. a
# local Ollama at http://127.0.0.1:11434). Default 'false' blocks them as an
# SSRF guard; link-local/metadata (169.254.0.0/16) stays blocked either way.
ALLOW_PRIVATE_UPSTREAMS=false

# Simulated streaming token rate (tokens/second). When a Model Service has
# Reliable Streaming enabled, the proxy buffers the complete upstream response
# and replays it as a paced SSE stream at this rate. Default 2000 tok/s.
SIMULATED_STREAMING_TOKEN_RATE=2000

# Storage budget for the OCR image cache, in bytes. A Micro Agent's image
# translation (OCR) pre-pass remembers each image's description keyed by a hash
# of the image itself, so a repeat of the same image skips the model entirely.
# Once the cache exceeds this budget, least-recently-used entries are deleted
# until it fits again. 0 turns caching off. Default 64 MiB. Changeable at
# runtime from Settings, which overrides this boot-time default.
IMAGE_CACHE_MAX_BYTES=67108864

# Dead-air guard for streaming requests. A buffering executor (Micro Agent,
# Reliable Streaming) or a slow upstream first token can be silent for minutes,
# and intermediaries (nginx, load balancers) and clients kill silent connections
# long before that. If a streaming request has produced no outcome within the
# grace window, the proxy commits the SSE response and emits keep-alive pings
# (Anthropic: real ping events; OpenAI: SSE comments) until it has one. A
# failure after that point is delivered as the protocol's in-stream error event
# (the request log keeps the real status); a failure faster than the grace
# window still gets its real HTTP status. Non-streaming requests are unaffected.
STREAM_COMMIT_GRACE_MS=2500
STREAM_PING_INTERVAL_MS=10000

# Remote restart is opt-in because Hydrogen cannot prove that exiting this
# process will deploy a new image. Enable only when a supervisor (for example a
# Kubernetes deployment with an appropriate image pull policy) is configured to
# restart Hydrogen onto the intended release. Leave false for bare Node and the
# repository's normal Docker Compose workflow; the dashboard will show manual
# update commands instead.
UPDATE_RESTART_ENABLED=false

# Set to 'production' in Docker; 'development' enables verbose logging.
NODE_ENV=production
