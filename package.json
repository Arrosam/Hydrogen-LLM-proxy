{
  "name": "hydrogen-llm-proxy",
  "version": "2.0.0",
  "private": true,
  "description": "Hydrogen - a lightweight, self-hosted personal LLM proxy",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n gateway,console -c blue,green \"npm:dev:gateway\" \"npm:dev:console\"",
    "dev:gateway": "npm run dev --workspace apps/gateway",
    "dev:console": "npm run dev --workspace apps/console",
    "build": "npm run build:packages && npm run build:console && npm run build:gateway",
    "build:packages": "node scripts/build-packages.mjs",
    "build:gateway": "npm run build --workspace apps/gateway",
    "build:console": "npm run build --workspace apps/console",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vitest": "^2.1.5",
    "typescript": "^5.6.3"
  }
}
