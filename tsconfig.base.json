{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@areelai/wire-format/request": [
        "./packages/wire-format/src/request.ts"
      ],
      "@areelai/wire-format/response": [
        "./packages/wire-format/src/response.ts"
      ],
      "@areelai/*": [
        "./packages/*/src/index.ts"
      ]
    }
  }
}
