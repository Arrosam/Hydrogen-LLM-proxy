  "description": "Micro Agents: forward-only stage pipelines with routers, conditions and OCR/ASR pre-passes, plugged into Model Services as a service kind.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arrosam/Hydrogen-LLM-proxy.git",
    "directory": "packages/micro-agent"
  },
  "homepage": "https://github.com/Arrosam/Hydrogen-LLM-proxy#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
