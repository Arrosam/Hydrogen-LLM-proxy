    "drizzle-orm": "^0.36.4",
    "better-sqlite3": "^11.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "@types/node": "^22.9.0",
    "@types/better-sqlite3": "^7.6.11",
